# Discord webhook used by app/api/discord/route.ts
# Create in Discord channel: Edit Channel -> Integrations -> Webhooks -> New Webhook
DISCORD_WEBHOOK_URL=

# Comma-separated list of allowed dev origins (e.g. your local network IP)
ALLOWED_DEV_ORIGINS=

# MongoDB Atlas connection string for analytics dual-write.
# Format: mongodb+srv://<user>:<password>@<cluster>/?appName=<app>
MONGODB_URI=
# Target database name (created on first write)
MONGODB_DB=laundry_silayan